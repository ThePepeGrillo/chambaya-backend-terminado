# Copia este archivo como ".env" y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Cadena de conexión de Neon (botón "Connect" en el panel de Neon)
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxx.neon.tech/neondb?sslmode=require

# Frase larga y secreta para firmar los tokens
JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

PORT=3000

# Direcciones del frontend que pueden llamar a la API (separadas por coma)
CORS_ORIGIN=http://localhost:5173

# Dirección pública del frontend: con ella se arma el enlace de "olvidé mi contraseña".
# Si no se indica, se usa la primera de CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

# Envío de correos (opcional). Sin RESEND_API_KEY, el enlace de recuperación se escribe en la terminal del backend.
# Se obtiene gratis en https://resend.com (en el plan gratuito solo envía al correo de tu propia cuenta hasta verificar un dominio)
RESEND_API_KEY=
EMAIL_FROM=ChambaYa <onboarding@resend.dev>

# SOLO para demos y pruebas: permite confirmar que un trabajo se completó antes de su fecha.
# Déjala en false (o sin definir) en el uso normal.
COMPLETAR_SIN_ESPERAR=false
